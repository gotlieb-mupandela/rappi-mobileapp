{
  "expo": {
    "name": "Rappi Sports Hub",
    "slug": "rappi-mobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/favicon-512.png",
    "scheme": "rappisportshub",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0B",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/brand/favicon-512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon-512.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image"
    ]
  }
}
