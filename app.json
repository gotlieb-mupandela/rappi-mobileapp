{
  "expo": {
    "name": "RAPPI Sports Hub",
    "slug": "rappi-sports-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brand/rappi-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rappi.sportshub"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.rappi.sportshub",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "RAPPI Sports Hub",
      "shortName": "RAPPI",
      "themeColor": "#B6FF00",
      "backgroundColor": "#0B0B0B"
    },
    "plugins": [],
    "extra": {
      "catalogSource": "https://github.com/gotlieb-mupandela/rappi-webapp",
      "storefront": "https://rappi-two.vercel.app"
    }
  }
}
